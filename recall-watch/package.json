{
  "name": "recall-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Matches federal recall feeds against what a household says it has, and texts once when it matters.",
  "scripts": {
    "ingest": "tsx src/cli.ts ingest",
    "match": "tsx src/cli.ts match",
    "deliver": "tsx src/cli.ts deliver",
    "demo": "tsx src/cli.ts demo",
    "eval": "tsx src/cli.ts eval",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && tsx src/cli.ts eval"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
