# Build artifacts - never transfer these, they regenerate
bin/
obj/
__pycache__/
*.pyc

# Unity - regenerated on first open, and enormous
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.csproj
*.sln
*.unityproj

# ...but the hand-written test project must travel, or the C# core suite
# can't run on a fresh clone.
!unity/tests/CoreTests/CoreTests.csproj

# Clip intermediates - 720 PNGs, the synthesized bed and the state trace, all
# regenerated by `node clip/build.mjs`. The finished mp4 beside them is committed
# on purpose so a fresh clone can watch it without a four-minute render.
clip/build/

# macOS
.DS_Store

# Local
*.log
