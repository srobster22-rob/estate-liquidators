# Build artifacts - never transfer these, they regenerate
bin/
obj/
__pycache__/
*.pyc

# Unity - regenerated on first open, and enormous
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.csproj
*.sln
*.unityproj

# ...but the hand-written test project must travel, or the C# core suite
# can't run on a fresh clone.
!unity/tests/CoreTests/CoreTests.csproj

# macOS
.DS_Store

# Local
*.log

# Screenshots the BONKHORDE test harness writes on each run
bonkhorde/shot-*.png
bonkhorde/sudden.png
# generated by build-artifact.js
*/artifact.html
# every mutated copy of the game is generated: the audit's own _mutant.html,
# and the hand-written ones that exist so a single check can be tested in
# isolation while an audit is already running and holding _mutant.html.
bonkhorde/_mutant*.html
bonkhorde/_altarprobe.html
# and the throwaway runner that drives one of those, which only lives in this
# directory because it resolves index.html and test.js relative to itself
bonkhorde/mutate[0-9].js
